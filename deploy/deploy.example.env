# Settings for scripts/deploy-extras-config.sh. Copy to deploy/deploy.env
# (git-ignored) and fill in. Environment variables override these values.

# SSH target of the panel host; needs an SSH key and passwordless sudo for chgrp.
HOST=user@panel-host

# Directory of the submix compose project on the host.
REMOTE_DIR=/opt/submix

# How long to wait for "extras-api started" before treating the config as broken.
#WAIT_SECONDS=20
